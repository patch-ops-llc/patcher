# Names only. Never put real values in this file or anywhere else in the repository.
# Locally, copy to .env (ignored by git). On Railway, set these as service variables.
# docs/setup-checklist.md says where each value comes from and which service needs it.

# --- Required: both services ---------------------------------------------------------
DATABASE_URL=

# --- Required: web -------------------------------------------------------------------
# At least 32 characters of random text. Signs session and sign-in cookies.
SESSION_SECRET=

# --- Slack app (PatchOps hub). Until these are set the services start, and the parts
# --- that need them report "not configured". ------------------------------------------
# web and worker
SLACK_TEAM_ID=
SLACK_BOT_TOKEN=
# web only
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
BOOTSTRAP_OWNER_SLACK_USER_ID=

# --- Token encryption. Calendly and Fathom keys typed into Settings are stored encrypted:
# --- web holds the public key and can only encrypt, worker holds the private key. Without
# --- the pair a call source cannot be connected. -----------------------------------------
# web only
TOKEN_PUBLIC_KEY=
# worker only
TOKEN_PRIVATE_KEY=

# --- Weekly audit. Worker only; never set these on web. Until they are set the audit,
# --- the GitHub checks and "Fix via agent" report "not configured". ---------------------
# Railway workspace token. Patcher only ever sends the read queries in src/railway/queries.ts.
RAILWAY_API_TOKEN=
# Cursor API key that starts the agent for an approved fix or an approved code change from a call.
CURSOR_API_KEY=
# Optional model id for those agents. Empty: the Cursor account's default.
CURSOR_AGENT_MODEL=
# GitHub App with read-only Metadata, Contents, Dependabot alerts and Pull requests permissions.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Anthropic API key. With it a model assesses the findings, ranks the report and drafts fix
# briefs. Without it the rules rank and word the report, and the report says so. It also matches
# calls to projects and drafts their suggestions; without it calls are collected and wait. And it
# says which calls were sales calls and drafts their proposals; without it none is drafted.
ANTHROPIC_API_KEY=

# --- Penguin deal room. Worker only; never set these on web. A second GitHub App, separate
# --- from the read-only one above, installed on the deal room repository alone, with
# --- Contents and Pull requests set to Read and write. Patcher uses it to open a pull
# --- request under content/<slug>/ after an approval, and for nothing else. Until these are
# --- set, proposals are still drafted and approved; the deal room step says "not configured".
DEALROOM_GITHUB_APP_ID=
DEALROOM_GITHUB_APP_PRIVATE_KEY=
DEALROOM_GITHUB_APP_INSTALLATION_ID=

# --- Optional ------------------------------------------------------------------------
# Public address of the web service. Defaults to https://$RAILWAY_PUBLIC_DOMAIN, then to
# http://localhost:$PORT. The worker needs it for links in Slack messages, and it is the address
# Calendly and Fathom webhooks are registered at (only when it is a public https address).
APP_BASE_URL=
# 1 = log approved actions instead of executing them. Overrides the switch in the UI.
DRY_RUN=
# debug | info | warn | error
LOG_LEVEL=
# Set by Railway.
PORT=
NODE_ENV=

# --- Local development only. Refused when NODE_ENV=production --------------------------
# Point the Slack client and Sign in with Slack at scripts/fake-slack.ts.
SLACK_API_URL=
SLACK_OIDC_URL=
# Point the Railway, Cursor, GitHub, Anthropic, Calendly, Fathom and deal room clients at local stand-ins.
RAILWAY_API_URL=
CURSOR_API_URL=
GITHUB_API_URL=
ANTHROPIC_API_URL=
CALENDLY_API_URL=
FATHOM_API_URL=
DEALROOM_GITHUB_API_URL=
