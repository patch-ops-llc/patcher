# Names only. Never put real values in this file or anywhere else in the repository.
# Locally, copy to .env (ignored by git). On Railway, set these as service variables.
# docs/setup-checklist.md says where each value comes from and which service needs it.

# --- Required: both services ---------------------------------------------------------
DATABASE_URL=

# --- Required: web -------------------------------------------------------------------
# At least 32 characters of random text. Signs session and sign-in cookies.
SESSION_SECRET=

# --- Slack app (PatchOps hub). Until these are set the services start, and the parts
# --- that need them report "not configured". ------------------------------------------
# web and worker
SLACK_TEAM_ID=
SLACK_BOT_TOKEN=
# web only
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
BOOTSTRAP_OWNER_SLACK_USER_ID=

# --- Token encryption for later phases (web holds the public key, worker the private) --
# web only
TOKEN_PUBLIC_KEY=
# worker only
TOKEN_PRIVATE_KEY=

# --- Weekly audit. Worker only; never set these on web. Until they are set the audit,
# --- the GitHub checks and "Fix via agent" report "not configured". ---------------------
# Railway workspace token. Patcher only ever sends the read queries in src/railway/queries.ts.
RAILWAY_API_TOKEN=
# Cursor API key that starts the agent for an approved fix.
CURSOR_API_KEY=
# Optional model id for those agents. Empty: the Cursor account's default.
CURSOR_AGENT_MODEL=
# GitHub App with read-only Metadata, Contents and Dependabot alerts permissions.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# --- Optional ------------------------------------------------------------------------
# Public address of the web service. Defaults to https://$RAILWAY_PUBLIC_DOMAIN, then to
# http://localhost:$PORT. The worker needs it for links in Slack messages.
APP_BASE_URL=
# 1 = log approved actions instead of executing them. Overrides the switch in the UI.
DRY_RUN=
# debug | info | warn | error
LOG_LEVEL=
# Set by Railway.
PORT=
NODE_ENV=

# --- Local development only. Refused when NODE_ENV=production --------------------------
# Point the Slack client and Sign in with Slack at scripts/fake-slack.ts.
SLACK_API_URL=
SLACK_OIDC_URL=
# Point the Railway, Cursor and GitHub clients at local stand-ins.
RAILWAY_API_URL=
CURSOR_API_URL=
GITHUB_API_URL=
